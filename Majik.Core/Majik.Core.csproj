<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Emit the source-generator output to disk so we can eyeball it
         in CI and during local debugging. Files land under
         obj/$(Configuration)/$(TargetFramework)/generated/. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <!-- JSON card definitions. Bundled into the assembly so the engine
         has no filesystem dependency at runtime. -->
    <EmbeddedResource Include="CardData/Cards/*.json" />
    <!-- ...and ALSO surfaced to the source generator as AdditionalFiles so it
         can emit a fileless dispatch arm per card name (PLAN 03 Slice 3). The
         JSON stays EmbeddedResource above — only the *dispatch* is generated;
         runtime loading via FromEmbeddedResource is unchanged. -->
    <AdditionalFiles Include="CardData/Cards/*.json" />
    <!-- Modern-legal card pool (~22k rows, ~1.9 MB gzipped). Loaded by
         EmbeddedCardRepository on first lookup. Regenerated by a
         follow-up offline script — see PR description. -->
    <EmbeddedResource Include="CardData/Embedded/modern-cards.json.gz" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotNetEnv" />
  </ItemGroup>

  <ItemGroup>
    <!-- Source generator: builds the [CardName]-driven dispatch table
         for NamedCardFactory at compile time. Loaded as an analyzer,
         never shipped as a runtime dependency. -->
    <ProjectReference Include="..\Majik.Core.SourceGen\Majik.Core.SourceGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
